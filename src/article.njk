---
layout: base.njk
pagination:
  data: articles
  size: 1
  alias: article
permalink: "/articles/{{ article.id }}/"
eleventyComputed:
  title: "{{ article.title_ja or article.title }}"
  description: "{{ article.summary_ja or article.summary }}"
---

<article class="container detail">
  <div class="card-meta">
    <span class="tag tag-{{ article.region }}">{{ article.region | regionLabel }}</span>
    <span class="src">{{ article.source }}</span>
    <time>{{ article.date | dateJP }}</time>
  </div>

  <h1>{{ article.title_ja or article.title }}</h1>
  {% if article.title_ja and article.title_ja != article.title %}
  <p class="detail-orig">原題: {{ article.title }}</p>
  {% endif %}

  <p class="detail-summary">{{ article.summary_ja or article.summary }}</p>

  {% if article.groups and article.groups.length %}
  <div class="chips">
    {% for g in article.groups %}
    <a class="chip" href="{{ '/' | url }}#g:{{ g.slug }}">{{ g.name }}</a>
    {% endfor %}
  </div>
  {% endif %}

  <p class="detail-source">
    この情報の出典: <a href="{{ article.link }}" target="_blank" rel="noopener nofollow">{{ article.source }} で全文を読む</a>
  </p>

  <p class="back"><a href="{{ '/' | url }}">← 一覧に戻る</a></p>
</article>
