---
permalink: /data/articles.json
eleventyExcludeFromCollections: true
---
{#- トップページの一覧は直近ぶんだけ配信して軽量に保つ。全期間は /archive/ から。 -#}
{%- set out = [] -%}
{%- for a in articles.slice(0, 600) -%}
  {%- set _ = out.push({ id: a.id, title: a.title, title_ja: a.title_ja, link: a.link, summary: a.summary, summary_ja: a.summary_ja, source: a.source, region: a.region, groups: a.groups, date: a.date }) -%}
{%- endfor -%}
{{ out | json | safe }}
